{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/playlist.schema.json",
  "title": "Codeflow FM Audio Playlist",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "station",
    "generatedAt",
    "tracks"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseUrl": {
      "type": "string",
      "minLength": 1
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "filename",
          "url",
          "sizeBytes",
          "sha256",
          "mime"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 8
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "artist": {
            "type": [
              "string",
              "null"
            ]
          },
          "filename": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "mime": {
            "type": "string",
            "enum": ["audio/mpeg", "audio/webm", "audio/webm; codecs=opus"],
            "description": "WebM tracks must contain Opus audio. Each track has a single source; no format fallback is used."
          },
          "durationSec": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "originalName": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
