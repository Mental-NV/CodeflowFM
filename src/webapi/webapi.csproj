<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SpaRoot>$(MSBuildProjectDirectory)/../spaclient</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.5" />
  </ItemGroup>

  <Target Name="SyncSpaAssetsToWwwroot" AfterTargets="Build" Condition="'$(Configuration)' != 'Release'">
    <ItemGroup>
      <SpaDistFiles Include="$(SpaRoot)/dist/**/*" />
      <ExistingSpaFiles Include="$(MSBuildProjectDirectory)/wwwroot/**/*"
                        Exclude="$(MSBuildProjectDirectory)/wwwroot/.gitkeep" />
    </ItemGroup>

    <MakeDir Directories="$(MSBuildProjectDirectory)/wwwroot" />
    <Delete Files="@(ExistingSpaFiles)" ContinueOnError="true" />
    <Copy SourceFiles="@(SpaDistFiles)"
          DestinationFiles="@(SpaDistFiles->'$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(SpaDistFiles)' != ''" />
  </Target>

  <Target Name="BuildSpaForPublish" BeforeTargets="ComputeFilesToPublish">
    <Exec Command="npm --prefix &quot;$(SpaRoot)&quot; run build" />
  </Target>

  <Target Name="IncludeSpaDistInPublish" BeforeTargets="ComputeFilesToPublish">
    <ItemGroup>
      <SpaDistPublishFiles Include="$(SpaRoot)/dist/**/*" />
      <ResolvedFileToPublish Include="@(SpaDistPublishFiles)" Condition="'@(SpaDistPublishFiles)' != ''">
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
